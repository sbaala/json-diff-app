{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["svelte"],
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"$lib": ["../frontend/src/lib"],
			"$lib/*": ["../frontend/src/lib/*"],
			"$app/environment": ["webview/shims/app-environment.ts"],
			"$app/stores": ["webview/shims/app-stores.ts"]
		}
	},
	"include": [
		"webview/**/*.ts",
		"webview/**/*.svelte",
		"../frontend/src/lib/**/*",
		"../frontend/src/routes/**/*"
	]
}
